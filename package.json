{
  "name": "wisp-ai",
  "version": "0.0.7",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "release": "release-it",
    "release:dry": "release-it --dry-run",
    "release:notes": "node scripts/sync-release-notes.ts",
    "web:dev": "turbo run dev --filter=@wisp/web",
    "web:build": "turbo run build --filter=@wisp/web",
    "start": "turbo run start --filter=@wisp/bridge",
    "agent": "turbo run dev --filter=@wisp/agent",
    "install-addon": "node apps/bridge/scripts/install.ts",
    "build": "turbo run build",
    "check": "turbo run format:check lint typecheck typecheck:root",
    "typecheck": "turbo run typecheck typecheck:root",
    "test": "turbo run test --concurrency=2",
    "test:ui": "turbo run test --filter=@wisp/desktop",
    "ui:dev": "turbo run dev --filter=@wisp/desktop",
    "ui:build": "turbo run build --filter=@wisp/desktop",
    "desktop:dev": "turbo run dev:native --filter=@wisp/desktop",
    "build:desktop": "turbo run package:windows --filter=@wisp/desktop",
    "package:windows": "pnpm build:desktop",
    "package:engine": "turbo run build --filter=@wisp/agent... && node scripts/build-engine.ts",
    "format": "oxfmt --write && stylua --verify .busted addon tests && prettier --plugin prettier-plugin-svelte --write \"apps/desktop/src/**/*.{svelte,css,html}\"",
    "format:check": "oxfmt --check && stylua --check .busted addon tests && prettier --plugin prettier-plugin-svelte --check \"apps/desktop/src/**/*.{svelte,css,html}\"",
    "lint": "oxlint --deny-warnings apps packages scripts tests addon/tests vitest.config.ts",
    "stage:desktop": "turbo run stage --filter=@wisp/desktop",
    "test:core": "turbo run test --concurrency=2 --filter=!@wisp/addon --filter=!@wisp/desktop",
    "test:addon": "turbo run test --filter=@wisp/addon",
    "test:watch": "turbo watch test --concurrency=2",
    "typecheck:root": "tsc --noEmit",
    "test:integration": "turbo run test --filter=@wisp/tests"
  },
  "devDependencies": {
    "@johnnymorganz/stylua-bin": "2.6.0",
    "@types/node": "24.19.2",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "release-it": "21.1.2",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "packageManager": "pnpm@12.18.0"
}
