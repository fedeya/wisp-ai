{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "curly": ["error", "multi-line"],
    "eqeqeq": "error",
    "no-var": "error"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    "**/.next/**",
    "**/.vercel/**",
    "runtime/**",
    "dist/**",
    "**/.eve/**",
    "**/node_modules/**",
    "**/src-tauri/**",
    "**/dist/**",
    "**/.output/**"
  ],
  "overrides": [
    {
      "files": ["apps/agent/**", "apps/desktop/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": ["@wisp/bridge", "@wisp/bridge/*"]
          }
        ]
      }
    },
    {
      "files": ["packages/protocol/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "@wisp/bridge",
              "@wisp/bridge/*",
              "@wisp/agent",
              "@wisp/agent/*",
              "@wisp/desktop",
              "@wisp/desktop/*"
            ]
          }
        ]
      }
    }
  ]
}
