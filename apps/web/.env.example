# Optional: override the direct, public Windows installer URL.
# Default: /download, which follows the latest stable GitHub Release.
# Use an asset URL, not a release page.
NEXT_PUBLIC_INSTALL_URL=

# Optional overrides for Wisp's public PostHog ingestion project.
# The public US project is configured by default in src/analytics.ts.
# Next.js uses NEXT_PUBLIC_, not VITE_. Never use a personal API key.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
