                                  "type": "boolean"
                                }
                              ]
                            }
                          },
                          "required": [
                            "field",
                            "op",
                            "value"
                          ],
                          "additionalProperties": false
                        },
                        "maxItems": 8,
                        "default": []
                      }
                    },
                    "required": [
                      "kind",
                      "event"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "interval"
                        ]
                      },
                      "seconds": {
                        "type": "integer",
                        "minimum": 60,
                        "maximum": 2592000
