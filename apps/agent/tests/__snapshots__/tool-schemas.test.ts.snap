                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "minItems": 1,
              "maxItems": 8
            },
            "cooldownSeconds": {
              "type": "integer",
              "minimum": 60,
              "maximum": 86400,
              "default": 600
            },
            "once": {
              "type": "boolean",
