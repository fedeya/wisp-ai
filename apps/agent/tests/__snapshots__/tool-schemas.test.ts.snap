              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "instruction": {
              "type": "string",
              "minLength": 1,
              "maxLength": 6000
            },
            "triggers": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "event"
                        ]
                      },
                      "event": {
                        "type": "string",
                        "enum": [
                          "level_up",
                          "equipment_changed",
                          "money_changed",
                          "bags_changed",
                          "quests_changed",
                          "spells_changed",
                          "talents_changed",
                          "zone_changed"
                        ]
                      },
                      "filters": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "field": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 40
                            },
                            "op": {
                              "type": "string",
                              "enum": [
                                "eq",
                                "ne",
                                "gte",
                                "lte",
                                "contains",
                                "multiple_of"
