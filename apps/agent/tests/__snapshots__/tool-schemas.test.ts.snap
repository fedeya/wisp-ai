exports[`the model sees the same web__web_search input schema 1`] = `
"{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "depth": {
      "type": "string",
      "enum": [
        "quick",
        "standard",
        "deep"
      ],
      "description": "Choose quick for a simple fact, standard for normal research, deep for conflicting evidence, missing acquisition routes or broad comparisons.",
      "default": "standard"
    },
    "maxResults": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12,
      "description": "Maximum returned findings/sources. Overrides the depth default."
    },
    "maxQueries": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6,
      "description": "Query budget including the primary query. Guidance for ChatGPT; bounds explicit query variants on Exa."
    },
    "timeoutSeconds": {
      "type": "integer",
      "minimum": 10,
      "maximum": 180,
      "description": "Total time budget for this tool call, not per query."
    },
    "excerptCharacters": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 12000,
      "description": "Maximum Exa excerpt length per source."
    },
    "queries": {
      "type": "array",
      "maxItems": 5,
      "description": "Optional additional focused query variants. Exa executes these within maxQueries; ChatGPT can use them as research directions.",
      "default": [],
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    }
  },
  "required": [
    "query"
  ],
  "additionalProperties": false
}"
`;

