exports[`the model sees the same wow__dungeon_loot input schema 1`] = `
"{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "instanceMapId": {
      "description": "instanceMapId from wow__query_dungeons; preferred.",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "dungeon": {
      "description": "Part of the English instance name, when no instanceMapId is known.",
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "boss": {
      "description": "Part of an English boss name, to read one boss.",
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "detail": {
      "description": "summary: every drop per boss with name, drop chance and required level, plus item level gain and stat changes for upgrades; full: also the stats of every item and the equipped item. Default: full with boss, summary without. A full answer too large for one read comes back as the summary.",
      "type": "string",
      "enum": [
        "summary",
        "full"
      ]
    },
    "includeUnusable": {
      "description": "Also list weapons and armor this character's class can never use. Leave it unset for the player's own gear; set it only for loot for another class.",
      "type": "boolean"
    }
  },
  "additionalProperties": false
}"
`;

